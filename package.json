{
  "name": "cdr-ai-negotiate",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "data-owner": "pnpm --filter @cdr-demo/data-owner-agent dev",
    "research": "pnpm --filter @cdr-demo/research-agent dev",
